# --- required: change all of these ---
MYSQL_PASSWORD=change-me-db-password
MYSQL_ROOT_PASSWORD=change-me-root-password
# REQUIRED: generate with `openssl rand -hex 32` (the server refuses to start with this example value)
JWT_SECRET=change-me-run-openssl-rand-hex-32
ADMIN_USERNAME=admin
# leave empty to have a random password printed in `docker compose logs server`
ADMIN_PASSWORD=

# Office time zone offset from UTC in minutes (Thailand = 420)
TZ_OFFSET_MINUTES=420

# API server threads (2 is enough for a small office)
SERVER_THREADS=2

# --- AI worker (docker compose --profile ai up -d) ---
# create an "AI Worker" device in Device Integration and paste its key here
AI_DEVICE_KEY=
AI_THREADS=2
# yolox_nano.onnx (lowest RAM) or yolox_tiny.onnx
AI_MODEL=yolox_nano.onnx
AI_MEM_LIMIT=512m
# analysis rate while people move in a desk zone (normal rate = ai_fps per camera)
AI_BOOST_FPS=8
# 1 = no cameras needed, generates demo activity
AI_SIMULATE=0
