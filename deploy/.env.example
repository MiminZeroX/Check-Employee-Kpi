# --- required: change all of these ---
MYSQL_PASSWORD=change-me-db-password
MYSQL_ROOT_PASSWORD=change-me-root-password
# REQUIRED: generate with `openssl rand -hex 32` (the server refuses to start with this example value)
JWT_SECRET=change-me-run-openssl-rand-hex-32
# REQUIRED: encryption key for stored secrets (camera passwords, MFA, webhooks): openssl rand -hex 32
DATA_KEY=
ADMIN_USERNAME=admin
# leave empty to have a random password printed in `docker compose logs server`
ADMIN_PASSWORD=

# Office time zone offset from UTC in minutes (Thailand = 420)
TZ_OFFSET_MINUTES=420

# API server threads (2 is enough for a small office)
SERVER_THREADS=2

# --- AI worker (docker compose --profile ai up -d) ---
# create an "AI Worker" device in Device Integration and paste its key here
AI_DEVICE_KEY=
AI_THREADS=2
# yolox_nano.onnx (lowest RAM) or yolox_tiny.onnx
AI_MODEL=yolox_nano.onnx
AI_MEM_LIMIT=512m
# analysis rate while people move in a desk zone (normal rate = ai_fps per camera)
AI_BOOST_FPS=8
# 1 = no cameras needed, generates demo activity
AI_SIMULATE=0

# --- HTTPS (docker compose --profile https up -d) ---
# public domain (Let's Encrypt) or LAN name / IP
SITE_ADDRESS=
# your e-mail for a public domain, or "internal" for a LAN-only certificate
TLS_MODE=internal
# with HTTPS: publish the plain port only on localhost and trust the proxy's client address
# SERVER_PUBLISH=127.0.0.1:8080
# TRUST_PROXY=1

# --- security ---
# API requests per second per client address (burst = 4x); 0 = off
RATE_LIMIT_RPS=20
# name shown in authenticator apps for two-step sign-in
MFA_ISSUER=Smart Office

# --- single sign-on (OpenID Connect: Google Workspace, Microsoft Entra ID, Keycloak, Authentik ...) ---
# e.g. https://accounts.google.com  or  https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# register this exact URL at the provider
OIDC_REDIRECT_URL=https://office.example.com/api/auth/oidc/callback
OIDC_BUTTON_LABEL=เข้าสู่ระบบด้วยบัญชีองค์กร
