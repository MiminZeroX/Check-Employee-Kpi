# Low-memory settings for a small office (up to ~200 employees, a few million activity rows).
# Raise innodb_buffer_pool_size if reports get slow (rule of thumb: size of the hot data).
[mysqld]
character-set-server     = utf8mb4
collation-server         = utf8mb4_unicode_ci
default-time-zone        = '+00:00'
performance_schema       = OFF
innodb_buffer_pool_size  = 64M
innodb_log_buffer_size   = 4M
innodb_log_file_size     = 48M
key_buffer_size          = 4M
aria_pagecache_buffer_size = 8M
max_connections          = 30
thread_cache_size        = 4
table_open_cache         = 256
table_definition_cache   = 256
tmp_table_size           = 16M
max_heap_table_size      = 16M
sort_buffer_size         = 1M
join_buffer_size         = 1M
read_buffer_size         = 256K
read_rnd_buffer_size     = 256K
query_cache_type         = 0
query_cache_size         = 0
skip-name-resolve
